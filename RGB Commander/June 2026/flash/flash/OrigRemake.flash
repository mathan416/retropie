<flash fade="160" delay="170">
	<frm rgb="0,0,0" delay="0"/>
	<frm rgb="255,255,255" delay="300"/>
	<frm rgb="0,0,0" fade="35"/>

	<frm rgb="255,0,0"/>

	<frm rgb="0,0,0"/>
	<frm rgb="255,255,255" delay="300"/>
	<frm rgb="0,0,0" fade="35"/>

	<frm rgb="0,255,0"/>

	<frm rgb="0,0,0"/>
	<frm rgb="255,255,255" delay="300"/>
	<frm rgb="0,0,0" fade="35"/>

	<frm rgb="0,0,255"/>

</flash>
